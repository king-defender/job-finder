# Copy to .env (not committed — see .gitignore)

# apps/api base URL — worker never touches Mongo/Ollama directly, it reads
# Job/Profile and reports results through the API instead.
API_URL=http://localhost:3001
REDIS_URL=redis://localhost:6379

# Optional — all of these must be set together for real email to send.
# Leave unset and notifications just log to the console instead (this path
# has never been tested against a real mail server in this repo's history).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL_FROM=you@example.com
# NOTIFY_EMAIL_TO=you@example.com

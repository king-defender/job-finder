# Copy to .env and adjust for your machine. Not committed (see .gitignore) —
# values here are often machine-specific (Ollama host/port, USB drive paths).

PORT=3001
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/job_agent
REDIS_URL=redis://localhost:6379

# Ollama — see packages/ai-engine/src/config.ts for defaults
OLLAMA_HOST=http://localhost:11434
AI_MODEL=qwen3:8b
